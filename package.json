{
  "name": "slipstream",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate  --config packages/db/drizzle.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.30.1",
    "drizzle-orm": "0.38.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "viem": "^2.55.19",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "^0.33.3",
    "@polymarket/clob-client-v2": "^1.1.0",
    "pg": "^8.23.0"
  }
}
